[
  {
    "name": "Read multiple history pages without repeating history",
    "messages": [
      {
        "role": "model",
        "type": "functioncall",
        "name": "pyokka_var",
        "arguments": {
          "name": "counter"
        }
      },
      {
        "role": "user",
        "type": "functionresponse",
        "name": "pyokka_var",
        "response": {
          "result": {
            "bounded": true,
            "tool": "pyokka_var",
            "outcome": "completed",
            "summary": {
              "name": "counter",
              "changes": 3
            },
            "cursor": "s1.root.0",
            "expires_in_ms": 300000
          }
        }
      },
      {
        "role": "user",
        "type": "message",
        "content": "Read all three changes from that captured result."
      }
    ],
    "expectedCall": [
      {
        "functionName": "pyokka_result",
        "arguments": {
          "cursor": "s1.root.0"
        },
        "mockOutput": {
          "kind": "object",
          "entries": [
            {
              "key": "changes",
              "value": {
                "ref": "s1.changes.0",
                "kind": "array",
                "total_count": 3
              }
            }
          ],
          "page_size": 1,
          "total_count": 1,
          "next_cursor": null
        }
      },
      {
        "functionName": "pyokka_result",
        "arguments": {
          "cursor": "s1.changes.0"
        },
        "mockOutput": {
          "kind": "array",
          "items": [
            1,
            2
          ],
          "page_size": 2,
          "total_count": 3,
          "next_cursor": "s1.changes.2"
        }
      },
      {
        "functionName": "pyokka_result",
        "arguments": {
          "cursor": "s1.changes.2"
        },
        "mockOutput": {
          "kind": "array",
          "items": [
            3
          ],
          "page_size": 1,
          "total_count": 3,
          "next_cursor": null
        }
      }
    ]
  },
