  {
    "name": "Expired cursor must not repeat producing action",
    "messages": [
      {
        "role": "model",
        "type": "functioncall",
        "name": "pyokka_result",
        "arguments": {
          "cursor": "s8.root.0"
        }
      },
      {
        "role": "user",
        "type": "functionresponse",
        "name": "pyokka_result",
        "response": {
          "result": {
            "isError": true,
            "error": "Retained details expired or were evicted. This read did not repeat the action.",
            "code": "RESULT_UNAVAILABLE",
            "retryable": false
          }
        }
      },
      {
        "role": "user",
        "type": "message",
        "content": "Stop reading. Explain that those captured details are unavailable; do not rerun anything."
      }
    ],
    "expectedCall": []
  },
  {
    "name": "Malformed cursor must not guess a producing action",
    "messages": [
      {
        "role": "model",
        "type": "functioncall",
        "name": "pyokka_result",
        "arguments": {
          "cursor": "not a supplied cursor"
        }
      },
      {
        "role": "user",
        "type": "functionresponse",
        "name": "pyokka_result",
        "response": {
          "result": {
            "isError": true,
            "error": "Use an exact cursor supplied by a previous large result.",
            "code": "INVALID_CURSOR",
            "retryable": false
          }
        }
      },
      {
        "role": "user",
        "type": "message",
        "content": "I have no supplied cursor. Explain what is missing without running anything."
      }
    ],
    "expectedCall": []
  },
  {
    "name": "Cancelled continuation can be read later without action dispatch",
    "messages": [
      {
        "role": "model",
        "type": "functioncall",
        "name": "pyokka_result",
        "arguments": {
          "cursor": "s9.root.0"
        }
      },
      {
        "role": "user",
        "type": "functionresponse",
        "name": "pyokka_result",
        "response": {
          "result": {
            "isError": true,
            "error": "Reading was cancelled; retained details were not changed.",
            "code": "CANCELLED",
            "retryable": false
          }
        }
      },
      {
        "role": "user",
        "type": "message",
        "content": "Read that retained result now, using the same cursor."
      }
    ],
    "expectedCall": [
      {
        "functionName": "pyokka_result",
        "arguments": {
          "cursor": "s9.root.0"
        }
      }
    ]
  },
  {
    "name": "Capacity failure preserves known completion",
    "messages": [
      {
        "role": "model",
        "type": "functioncall",
        "name": "pyokka_profile",
        "arguments": {}
      },
      {
        "role": "user",
        "type": "functionresponse",
