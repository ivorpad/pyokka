        "response": {
          "result": {
            "bounded": true,
            "isError": true,
            "tool": "pyokka_profile",
            "outcome": "completed",
            "summary": {
              "totalMs": 12
            },
            "error": "The action completed; full details exceed retention capacity and cannot be read with a cursor.",
            "code": "RESULT_TOO_LARGE",
            "retryable": false,
            "cursor": null
          }
        }
      },
      {
        "role": "user",
        "type": "message",
        "content": "Explain the known outcome and missing details. Do not run it again."
      }
    ],
    "expectedCall": []
